# Local development (docker compose up -d)
DATABASE=govzalla_t_25
DATABASE_HOST=127.0.0.1
DATABASE_USER=tallam
DATABASE_PASSWORD=tallam_local
DB_PORT=3307

APP_PORT=4000
FRONTEND_URL=http://localhost:5173

SESSION_LIFETIME=7200000
SESSION_NAME=smad
SESSION_SECRET=change-me-in-production
# Отдельный случайный секрет (не менее 32 символов) для шифрования паспортных данных
SUBSCRIPTION_DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret

# SMTP for password reset emails (optional in local dev — link prints to console)
# Local mail: start Mailpit with `docker compose up -d mailpit` (UI at SMTP_PREVIEW_URL).
# If Mailpit is not running, letters are saved to backend/data/outbox and opened from the app.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tallam <noreply@tallam.local>"
SMTP_PREVIEW_URL=http://localhost:8025
PASSWORD_RESET_EXPIRES_MINUTES=60

# Secret accountant page /status. Production must set both values.
# Local defaults, when these are empty: durdieva67@mail.ru / 888888
ACCOUNTANT_LOGIN=
ACCOUNTANT_PASSWORD=

# Production later: mailbox SMTP, for example mail.ru
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=webrush@mail.ru
# SMTP_PASS=
# SMTP_FROM="Tallam <webrush@mail.ru>"

