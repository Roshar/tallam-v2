{
  "name": "tallam-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Tallam — информационно-аналитическая образовательная платформа",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:iro": "npm run dev -w iro-frontend",
    "build": "npm run build -w backend && npm run build -w frontend && npm run build -w iro-frontend",
    "iro:user:create": "node scripts/create-iro-user.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "db:import": "bash database/import-dump.sh",
    "db:import-subscriptions": "node database/import-subscriptions.mjs",
    "backup:fetch": "bash scripts/fetch-prod-backup.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "workspaces": [
    "backend",
    "frontend",
    "iro-frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
